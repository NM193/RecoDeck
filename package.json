{
  "name": "recodeck",
  "private": true,
  "version": "0.2.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icon": "node scripts/generate-app-icon.js && tauri icon app-icon.png",
    "version:sync": "node scripts/sync-version.js",
    "version:patch": "npm version patch && npm run version:sync",
    "version:minor": "npm version minor && npm run version:sync",
    "version:major": "npm version major && npm run version:sync",
    "build:mac": "npm run version:sync && tauri build --target universal-apple-darwin",
    "build:win": "npm run version:sync && tauri build --target x86_64-pc-windows-msvc",
    "build:dev": "tauri build --debug",
    "release:sign": "tauri signer sign src-tauri/target/release/bundle/macos/recodeck.app.tar.gz -k ~/.tauri/recodeck.key",
    "release:manifest": "node scripts/generate-update-manifest.js",
    "mobile:dev": "vite --config mobile/vite.config.ts",
    "mobile:build": "vite build --config mobile/vite.config.ts",
    "lint": "eslint src mobile",
    "lint:fix": "eslint src mobile --fix",
    "format": "prettier --write src mobile",
    "format:check": "prettier --check src mobile",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-virtual": "^3.13.18",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.564.0",
    "markdown-to-jsx": "^7.4.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.13.0",
    "react-textarea-autosize": "^8.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.0.4",
    "vitest": "^4.0.18"
  }
}

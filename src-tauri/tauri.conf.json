{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "recodeck",
  "version": "0.2.15",
  "identifier": "com.nemanjamarjanovic.recodeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run mobile:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "recodeck",
        "width": 800,
        "height": 600,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: asset: https://asset.localhost/; media-src 'self' stream: http: https: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../mobile/dist/": "mobile-dist/"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/NM193/RecoDeck/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBMTE5REYzQ0ZDQjk1RDQKUldUVWxjdlA4NTBSV3VuMTBzWDYzeDFkYmZqVklnU1ZZZ2NLejVMcmVTSEFCelNnK2FjN1FZNlAK"
    }
  }
}